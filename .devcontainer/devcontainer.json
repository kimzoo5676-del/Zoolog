{
  "name": "zoolog",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/zoolog",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [5173],
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "25" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  }
}